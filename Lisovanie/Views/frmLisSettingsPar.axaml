<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Lisovanie.Models"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="750"
        x:Class="Lisovanie.Views.FrmLisSettingsPar"
        x:DataType="models:CParametersLis"
        Width="500" Height="750"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style Selector="Button.numpad">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                <Button Content="Save Parameters" Click="BtnSave_OnClick" Width="150" HorizontalContentAlignment="Center"/>
                <Button Content="Load Parameters" Click="BtnLoad_OnClick" Width="150" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Zavrieť" Click="BtnClose_OnClick" Width="100" HorizontalContentAlignment="Center" Background="#B22222" Foreground="White"/>
            </StackPanel>
        </Grid>

        <TabControl>
            <!-- Lis Tab -->
            <TabItem Header="Lis">
                <ScrollViewer>
                    <StackPanel Spacing="5" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Výška násypacia:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.VyskaNasypacia, StringFormat={}{0:F2}}" Click="BtnLisVyskaNasypacia_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Výška priblíženie:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.VyskaPriblizenie, StringFormat={}{0:F2}}" Click="BtnLisVyskaPriblizenie_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <Separator Height="1" Background="LightGray" Margin="0,10"/>
                        <TextBlock Text="Kalibrácia" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Výška kalibra:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.VyskaKalibra, StringFormat={}{0:F3}}" Click="BtnLisVyskaKalibra_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="VyskaSenAbsolut 1:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.VyskaSenAbsolut1, StringFormat={}{0:F3}}" Click="BtnLisVyskaSenAbsolut1_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="SilaKalib 1:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.SilaKalib1, StringFormat={}{0:F0}}" Click="BtnLisSilaKalib1_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="VyskaSenAbsolut 2:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.VyskaSenAbsolut2, StringFormat={}{0:F3}}" Click="BtnLisVyskaSenAbsolut2_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="SilaKalib 2:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.SilaKalib2, StringFormat={}{0:F0}}" Click="BtnLisSilaKalib2_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <Button Content="Prepočítať kalibráciu" Click="BtnRecalculate_OnClick" HorizontalAlignment="Stretch" Margin="0,5" Background="SteelBlue" Foreground="White"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Smernica K:"/>
                            <TextBox Text="{Binding ParLis.SmernicaK, StringFormat={}{0:F8}}" IsReadOnly="True" Width="200" Margin="0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Konštanta B:"/>
                            <TextBox Text="{Binding ParLis.KonstantaB, StringFormat={}{0:F4}}" IsReadOnly="True" Width="200" Margin="0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="VyskaSenPulz:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.VyskaSenPulz, StringFormat={}{0:F2}}" Click="BtnLisVyskaSenPulz_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Výška čistenia:"/>
                            <Button Classes="numpad" Content="{Binding ParLis.VyskaCistenia, StringFormat={}{0:F2}}" Click="BtnLisVyskaCistenia_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Konzola Tab -->
            <TabItem Header="Konzola">
                <StackPanel Spacing="5" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Výška odoberacia:"/>
                        <Button Classes="numpad" Content="{Binding ParKonzola.VyskaOdoberacia, StringFormat={}{0:F2}}" Click="BtnKonzolaVyskaOdoberacia_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Výška násypacia:"/>
                        <Button Classes="numpad" Content="{Binding ParKonzola.VyskaNasypacia, StringFormat={}{0:F2}}" Click="BtnKonzolaVyskaNasypacia_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Výška lisovacia:"/>
                        <Button Classes="numpad" Content="{Binding ParKonzola.VyskaLisovacia, StringFormat={}{0:F2}}" Click="BtnKonzolaVyskaLisovacia_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Výška čistenia:"/>
                        <Button Classes="numpad" Content="{Binding ParKonzola.VyskaCistenia, StringFormat={}{0:F2}}" Click="BtnKonzolaVyskaCistenia_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Cyklov čistenia:"/>
                        <Button Classes="numpad" Content="{Binding ParKonzola.CyklovCistenia, StringFormat={}{0:F0}}" Click="BtnKonzolaCyklovCistenia_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Výrobok Tab -->
            <TabItem Header="Výrobok">
                <StackPanel Spacing="5" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Názov:"/>
                        <TextBox Text="{Binding ParVyrobok.Name}" Width="200" Margin="0,2"/>
                    </StackPanel>
                    <Separator Height="1" Background="LightGray" Margin="0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Výška Max:"/>
                        <Button Classes="numpad" Content="{Binding ParVyrobok.VyskaMax, StringFormat={}{0:F2}}" Click="BtnVyrobokVyskaMax_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Výška Min:"/>
                        <Button Classes="numpad" Content="{Binding ParVyrobok.VyskaMin, StringFormat={}{0:F2}}" Click="BtnVyrobokVyskaMin_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Výška Požadovaná:"/>
                        <Button Classes="numpad" Content="{Binding ParVyrobok.VyskaPozadovana, StringFormat={}{0:F2}}" Click="BtnVyrobokVyskaPozadovana_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <Separator Height="1" Background="LightGray" Margin="0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Sila Max:"/>
                        <Button Classes="numpad" Content="{Binding ParVyrobok.SilaMax, StringFormat={}{0:F0}}" Click="BtnVyrobokSilaMax_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Sila Min:"/>
                        <Button Classes="numpad" Content="{Binding ParVyrobok.SilaMin, StringFormat={}{0:F0}}" Click="BtnVyrobokSilaMin_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Sila Požadovaná:"/>
                        <Button Classes="numpad" Content="{Binding ParVyrobok.SilaPozadovana, StringFormat={}{0:F0}}" Click="BtnVyrobokSilaPozadovana_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Váha Tab -->
            <TabItem Header="Váha">
                <StackPanel Spacing="5" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Váha Požadovaná:"/>
                        <Button Classes="numpad" Content="{Binding ParVaha.VahaPozadovana, StringFormat={}{0:F2}}" Click="BtnVahaVahaPozadovana_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Váha Max:"/>
                        <Button Classes="numpad" Content="{Binding ParVaha.VahaMax, StringFormat={}{0:F2}}" Click="BtnVahaVahaMax_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Váha Min:"/>
                        <Button Classes="numpad" Content="{Binding ParVaha.VahaMin, StringFormat={}{0:F2}}" Click="BtnVahaVahaMin_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Systém Tab -->
            <TabItem Header="Systém">
                <StackPanel Spacing="5" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="CAN Line:"/>
                        <Button Classes="numpad" Content="{Binding CanLine, StringFormat={}{0:F0}}" Click="BtnSysCanLine_OnClick" Width="100" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Board Line:"/>
                        <Button Classes="numpad" Content="{Binding BoardLine, StringFormat={}{0:F0}}" Click="BtnSysBoardLine_OnClick" Width="100" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <Separator Height="1" Background="LightGray" Margin="0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="ID Váha 1:"/>
                        <Button Classes="numpad" Content="{Binding IDVaha1, StringFormat={}{0:F0}}" Click="BtnSysIDVaha1_OnClick" Width="100" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="ID Váha 2:"/>
                        <Button Classes="numpad" Content="{Binding IDVaha2, StringFormat={}{0:F0}}" Click="BtnSysIDVaha2_OnClick" Width="100" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="ID Váha 3:"/>
                        <Button Classes="numpad" Content="{Binding IDVaha3, StringFormat={}{0:F0}}" Click="BtnSysIDVaha3_OnClick" Width="100" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="ID Box:"/>
                        <Button Classes="numpad" Content="{Binding IDBox, StringFormat={}{0:F0}}" Click="BtnSysIDBox_OnClick" Width="100" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>