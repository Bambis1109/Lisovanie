<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="using:Lisovanie.Views.UserControls"
        x:Class="Lisovanie.Views.frmLogin"
        Title="Prihlásenie"
        Width="300" Height="540"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="10" Spacing="8">
            <TextBlock x:Name="ErrorText" Foreground="#FF5252" FontWeight="Bold"
                       HorizontalAlignment="Center" Text=""/>
            <Button Content="Zmena hesla" Click="BtnChange_OnClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,8" Background="SteelBlue" Foreground="White" FontWeight="Bold"/>
            <Button Content="Zrušiť" Click="BtnCancel_OnClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,8" Background="#B22222" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <uc:UcNumpad x:Name="Pad" Confirmed="Pad_OnConfirmed" Cancelled="Pad_OnCancelled"/>
    </DockPanel>
</Window>
