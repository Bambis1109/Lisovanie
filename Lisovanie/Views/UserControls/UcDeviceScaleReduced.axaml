<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Lisovanie.ViewModels"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="48"
             x:Class="Lisovanie.Views.UserControls.UcDeviceScaleReduced"
             x:DataType="vm:UcDeviceScaleViewModel"
             IsEnabled="{Binding IsUiEnabled}">

    <Grid ColumnDefinitions="40, 85, 95" RowDefinitions="24, 24">

        <!-- Node ID – spans both rows -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="#555555" Margin="0,0,2,0">
            <TextBlock Text="{Binding NodeId}"
                       FontWeight="Bold" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Row 0: NMT | MainProc -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{Binding NmtColor}" Margin="0,0,1,1">
            <TextBlock Text="{Binding NmtText}"
                       Foreground="White" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="2"
                Background="{Binding MainProcColor}" Margin="0,0,0,1">
            <TextBlock Text="{Binding StatusMainProc}"
                       Foreground="White" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Row 1: WeightFinal | Mat -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{Binding WeightResultColor}" Margin="0,0,1,0">
            <TextBlock Text="{Binding WeightFinalGr, StringFormat={}{0:F2} g}"
                       Foreground="White" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="2"
                Background="{Binding MainMatColor}" Margin="0,0,0,0">
            <TextBlock Text="{Binding StatusMainMat}"
                       Foreground="White" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
