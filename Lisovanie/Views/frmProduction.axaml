<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Lisovanie.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="900"
        x:Class="Lisovanie.Views.frmProduction"
        x:DataType="vm:ProductionViewModel"
        Title="Výrobné dáta"
        Width="700" Height="900" MaxWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">

        <!-- Panel filtrov -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#444" BorderThickness="1"
                CornerRadius="5" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Od:" Width="50" Foreground="#DDD" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding FilterOd}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Do:" Width="50" Foreground="#DDD" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding FilterDo}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Status:" Width="50" Foreground="#DDD" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedIndex="{Binding FilterStatusIndex}" MinWidth="120"/>
                    <Button Content="Export CSV" Click="BtnExport_OnClick"
                            Background="SteelBlue" Foreground="White" FontWeight="Bold"
                            Padding="16,8" CornerRadius="5" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabuľka posledných výrobkov -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding LatestRecords}"
                  IsReadOnly="True" GridLinesVisibility="All"
                  CanUserResizeColumns="True" CanUserSortColumns="False"
                  Background="#1E1E1E" BorderBrush="#444" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Čas" Width="130"
                                    Binding="{Binding TimestampLocal, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"/>
                <DataGridTextColumn Header="Hmot.[g]" Width="80"
                                    Binding="{Binding Hmotnost, StringFormat='{}{0:F3}'}"/>
                <DataGridTextColumn Header="Sila" Width="60"
                                    Binding="{Binding Sila, StringFormat='{}{0:F1}'}"/>
                <DataGridTextColumn Header="Vzdial." Width="80"
                                    Binding="{Binding Vzdialenost, StringFormat='{}{0:F3}'}"/>
                <DataGridTextColumn Header="Zhutň.[ms]" Width="85"
                                    Binding="{Binding CasZhutnovaniaMs}"/>
                <DataGridTextColumn Header="Zotrv.[ms]" Width="85"
                                    Binding="{Binding CasZotrvaniaMs}"/>
                <DataGridTextColumn Header="Status" Width="*"
                                    Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Tlačidlá -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0" Spacing="10">
            <Button Content="Obnoviť" Command="{Binding RefreshCommand}"
                    Background="#37474F" Foreground="White" FontWeight="Bold"
                    Padding="20,10" CornerRadius="5"/>
            <Button Content="Zavrieť" Click="BtnClose_OnClick"
                    Background="#B22222" Foreground="White" FontWeight="Bold"
                    Padding="20,10" CornerRadius="5"/>
        </StackPanel>
    </Grid>
</Window>
