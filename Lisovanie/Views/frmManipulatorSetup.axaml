<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="using:Lisovanie.Views.UserControls"
        xmlns:models="using:Lisovanie.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
        x:Class="Lisovanie.Views.frmManipulatorSetup"
        x:DataType="models:CControlManipulator"
        Width="780" Height="900"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">
    
    <Grid RowDefinitions="*, Auto">
        <uc:UcControlManipulatorSetup Name="UcSetup" Grid.Row="0" />
        <Button Grid.Row="1" Content="Zavrieť" Click="BtnClose_OnClick" 
                HorizontalAlignment="Right" Margin="15" Padding="20,10" 
                Background="#B22222" Foreground="White" FontWeight="Bold" CornerRadius="5"/>
    </Grid>
</Window>