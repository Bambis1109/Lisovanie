<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:Lisovanie.Models"
        xmlns:vm="using:Lisovanie.ViewModels"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="700"
        x:Class="Lisovanie.Views.FrmManipulatorSettingsPar"
        x:DataType="models:CParameters"
        Width="500" Height="700"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style Selector="Button.numpad">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                <Button Content="Save Parameters" Click="BtnSave_OnClick" Width="150" HorizontalContentAlignment="Center"/>
                <Button Content="Load Parameters" Click="BtnLoad_OnClick" Width="150" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Zavrieť" Click="BtnClose_OnClick" Width="100" HorizontalContentAlignment="Center" Background="#B22222" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- Spoločné pre obe matice - preto nad záložkami, nie v nich -->
        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Classes="label" Text="Rozloženie matíc:"/>
                <ComboBox ItemsSource="{x:Static models:CParameters.RozlozeniaMatice}"
                          SelectedItem="{Binding RozlozenieMatice}"
                          Width="150" Height="40"/>
            </StackPanel>
            <TextBlock Text="DIA = striedavé riadky, SQR = pravouhlá mriežka. Platí pre OK aj NOK. Prejaví sa po novom Inite."
                       TextWrapping="Wrap" FontSize="11" Foreground="#9E9E9E"/>
        </StackPanel>

        <TabControl>
            <!-- Matica OK -->
            <TabItem Header="Matica OK">
                <StackPanel Spacing="5" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="X prvý:"/>
                        <Button Classes="numpad" Content="{Binding MatrixOkXfirst}" Click="BtnOkXfirst_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Y prvý:"/>
                        <Button Classes="numpad" Content="{Binding MatrixOkYfirst}" Click="BtnOkYfirst_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="X delta:"/>
                        <Button Classes="numpad" Content="{Binding MatrixOkXdelta}" Click="BtnOkXdelta_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Y delta:"/>
                        <Button Classes="numpad" Content="{Binding MatrixOkYdelta}" Click="BtnOkYdelta_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Počet X:"/>
                        <Button Classes="numpad" Content="{Binding MatrixOkXnum}" Click="BtnOkXnum_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Počet Y:"/>
                        <Button Classes="numpad" Content="{Binding MatrixOkYnum}" Click="BtnOkYnum_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Matica NOK -->
            <TabItem Header="Matica NOK">
                <StackPanel Spacing="5" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="X prvý:"/>
                        <Button Classes="numpad" Content="{Binding MatrixNokXfirst}" Click="BtnNokXfirst_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Y prvý:"/>
                        <Button Classes="numpad" Content="{Binding MatrixNokYfirst}" Click="BtnNokYfirst_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="X delta:"/>
                        <Button Classes="numpad" Content="{Binding MatrixNokXdelta}" Click="BtnNokXdelta_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Y delta:"/>
                        <Button Classes="numpad" Content="{Binding MatrixNokYdelta}" Click="BtnNokYdelta_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Počet X:"/>
                        <Button Classes="numpad" Content="{Binding MatrixNokXnum}" Click="BtnNokXnum_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="Počet Y:"/>
                        <Button Classes="numpad" Content="{Binding MatrixNokYnum}" Click="BtnNokYnum_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Delta -->
            <TabItem Header="Delta">
                <StackPanel Spacing="5" Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="OffsetArm:"/>
                        <Button Classes="numpad" Content="{Binding OffsetArm}" Click="BtnOffsetArm_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="label" Text="OffsetSystem:"/>
                        <Button Classes="numpad" Content="{Binding OffsetSystem}" Click="BtnOffsetSystem_OnClick" Width="150" HorizontalContentAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Manipulátor - dráhy z receptu -->
            <TabItem Header="Manipulátor">
                <Grid x:Name="ManipTabContent" x:DataType="vm:ManipulatorParametersViewModel"
                      RowDefinitions="*, Auto" Margin="10">
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ParameterItemViewModel">
                                    <Grid ColumnDefinitions="*, 150" Margin="0,3">
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="numpad"
                                                Content="{Binding Value}"
                                                Click="BtnManipValue_OnClick"
                                                GotFocus="ManipControl_GotFocus"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Panel popisu (Description) -->
                    <Border Grid.Row="1" Background="#252526" BorderBrush="DimGray" BorderThickness="1"
                            CornerRadius="3" Padding="10" Margin="0,10,0,0" MinHeight="90">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedParameter.DisplayName}" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SelectedParameter.Description}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
