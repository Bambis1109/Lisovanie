<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Lisovanie.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="Lisovanie.Views.frmZoneSetup"
        x:DataType="vm:MainWindowViewModel"
        Title="Zóna Lisu – Nastavenie"
        Width="700" Height="700"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        CanResize="False"
        Background="#1E1E1E">

    <Grid Margin="10" RowDefinitions="Auto, *, Auto">

        <!-- Zone row -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Background="#2D2D30"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding ZonePress.Name}"
                           Foreground="White"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Owner:"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding ZoneOwners}"
                          SelectedItem="{Binding ZonePress.Owner, Mode=TwoWay}"
                          Width="130"/>

                <TextBlock Text="Status:"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding ZoneStatuses}"
                          SelectedItem="{Binding ZonePress.Status, Mode=TwoWay}"
                          Width="150"/>
            </StackPanel>
        </Border>

        <!-- COM Port Sniffer -->
        <Border Grid.Row="1"
                Background="#2D2D30"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">
            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="COM Port Sniffer"
                           Foreground="#AAD4F5"
                           FontWeight="Bold"
                           FontSize="13"/>

                <!-- Connection row -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="Port:" Foreground="White" VerticalAlignment="Center" Width="35"/>
                    <ComboBox Name="CbxPort" Width="100" />
                    <TextBlock Text="Baud:" Foreground="White" VerticalAlignment="Center" Width="35"/>
                    <AutoCompleteBox Name="CbxBaud" Width="110"
                                     MinimumPrefixLength="0"
                                     FilterMode="None"
                                     FontFamily="Consolas"
                                     FontSize="12"/>
                    <Button Name="BtnRefreshPorts" Content="↻"
                            Click="BtnRefreshPorts_OnClick"
                            Padding="8,4" ToolTip.Tip="Obnoviť porty"/>
                    <Button Name="BtnConnect" Content="Pripojiť"
                            Click="BtnConnect_OnClick"
                            Padding="12,4" Background="SteelBlue" Foreground="White"/>
                </StackPanel>

                <!-- Options row -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <CheckBox Name="ChkTimestamp" Content="Čas" Foreground="White" IsChecked="True"
                              IsCheckedChanged="ChkTimestamp_IsCheckedChanged"/>
                    <CheckBox Name="ChkAutoScroll" Content="Auto-scroll" Foreground="White" IsChecked="True"/>
                    <Button Content="↓ Na koniec" Click="BtnScrollToEnd_OnClick"
                            Padding="8,3" Background="#2E4A1E" Foreground="White"
                            ToolTip.Tip="Zapnúť auto-scroll a skočiť na posledný riadok"/>
                    <Button Content="Vymazať" Click="BtnClear_OnClick"
                            Padding="10,3" Background="#555" Foreground="White"/>
                    <Button Content="Uložiť log" Click="BtnSaveLog_OnClick"
                            Padding="10,3" Background="#4A4A00" Foreground="White"/>
                    <Button Content="Spracuj pre AI" Click="BtnProcessForAi_OnClick"
                            Padding="10,3" Background="DodgerBlue" Foreground="White"/>
                </StackPanel>

                <!-- TX row (jeden riadok pod RX: modulové povely + voľný text) -->
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0"
                      ColumnDefinitions="Auto, Auto, Auto, *, Auto">
                    <ComboBox Grid.Column="0" Name="CbxModule" Width="110"
                              SelectionChanged="CbxModule_OnSelectionChanged"/>
                    <ComboBox Grid.Column="1" Name="CbxCommand" Width="150" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="↵" Click="BtnSendCommand_OnClick"
                            Margin="8,0,0,0" Padding="10,4" Background="#1A5276" Foreground="White"
                            ToolTip.Tip="Odoslať vybraný povel"/>
                    <TextBox Grid.Column="3" Name="TxtSend" Margin="8,0,0,0"
                             PlaceholderText="Vlastný príkaz"
                             FontFamily="Consolas"
                             FontSize="11"/>
                    <Button Grid.Column="4" Content="Odoslať" Click="BtnSend_OnClick"
                            Margin="8,0,0,0" Padding="12,4" Background="#2E7D32" Foreground="White"/>
                </Grid>

                <!-- Received data (posledné dieťa DockPanelu — vyplní zvyšok) -->
                <ListBox Name="LstReceived"
                         Margin="0,8,0,0"
                         Background="#111111"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Padding="2"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#D4D4D4"
                                       TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerTheme>
                        <ControlTheme TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </ControlTheme>
                    </ListBox.ItemContainerTheme>
                </ListBox>

            </DockPanel>
        </Border>

        <Button Grid.Row="2" Content="Zavrieť" Click="BtnClose_OnClick"
                Margin="0,8,0,0"
                Padding="20,8" Background="#B22222" Foreground="White"
                FontWeight="Bold" CornerRadius="4"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>
