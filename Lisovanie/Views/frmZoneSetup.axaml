<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Lisovanie.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="Lisovanie.Views.frmZoneSetup"
        x:DataType="vm:MainWindowViewModel"
        Title="Zóna Lisu – Nastavenie"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        CanResize="False"
        Background="#1E1E1E">

    <StackPanel Margin="10" Spacing="8">

        <!-- Zone row -->
        <Border Background="#2D2D30"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding ZonePress.Name}"
                           Foreground="White"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Owner:"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding ZoneOwners}"
                          SelectedItem="{Binding ZonePress.Owner, Mode=TwoWay}"
                          Width="130"/>

                <TextBlock Text="Status:"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding ZoneStatuses}"
                          SelectedItem="{Binding ZonePress.Status, Mode=TwoWay}"
                          Width="150"/>
            </StackPanel>
        </Border>

        <!-- COM Port Sniffer -->
        <Border Background="#2D2D30"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">
            <StackPanel Spacing="8">

                <TextBlock Text="COM Port Sniffer"
                           Foreground="#AAD4F5"
                           FontWeight="Bold"
                           FontSize="13"/>

                <!-- Connection row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Port:" Foreground="White" VerticalAlignment="Center" Width="35"/>
                    <ComboBox Name="CbxPort" Width="100" />
                    <TextBlock Text="Baud:" Foreground="White" VerticalAlignment="Center" Width="35"/>
                    <AutoCompleteBox Name="CbxBaud" Width="110"
                                     MinimumPrefixLength="0"
                                     FilterMode="None"
                                     FontFamily="Consolas"
                                     FontSize="12"/>
                    <Button Name="BtnRefreshPorts" Content="↻"
                            Click="BtnRefreshPorts_OnClick"
                            Padding="8,4" ToolTip.Tip="Obnoviť porty"/>
                    <Button Name="BtnConnect" Content="Pripojiť"
                            Click="BtnConnect_OnClick"
                            Padding="12,4" Background="SteelBlue" Foreground="White"/>
                </StackPanel>

                <!-- Options row -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Name="ChkHex" Content="HEX" Foreground="White"
                              IsCheckedChanged="ChkHex_IsCheckedChanged"/>
                    <CheckBox Name="ChkTimestamp" Content="Čas" Foreground="White" IsChecked="True"
                              IsCheckedChanged="ChkTimestamp_IsCheckedChanged"/>
                    <CheckBox Name="ChkAutoScroll" Content="Auto-scroll" Foreground="White" IsChecked="True"/>
                    <Button Content="Vymazať" Click="BtnClear_OnClick"
                            Padding="10,3" Background="#555" Foreground="White"/>
                    <Button Content="Uložiť log" Click="BtnSaveLog_OnClick"
                            Padding="10,3" Background="#4A4A00" Foreground="White"/>
                    <Button Content="Spracuj pre AI" Click="BtnProcessForAi_OnClick"
                            Padding="10,3" Background="DodgerBlue" Foreground="White"/>
                </StackPanel>

                <!-- Quick command row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Modul:" Foreground="White" VerticalAlignment="Center" Width="42"/>
                    <ComboBox Name="CbxModule" Width="120"
                              SelectionChanged="CbxModule_OnSelectionChanged"/>
                    <TextBlock Text="Povel:" Foreground="White" VerticalAlignment="Center" Width="38"/>
                    <ComboBox Name="CbxCommand" Width="170"/>
                    <Button Content="↵ Odoslať" Click="BtnSendCommand_OnClick"
                            Padding="12,4" Background="#1A5276" Foreground="White"/>
                </StackPanel>

                <!-- Received data -->
                <ListBox Name="LstReceived"
                         Height="220"
                         Background="#111111"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Padding="2"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#D4D4D4"
                                       TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Send row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="TX:" Foreground="White" VerticalAlignment="Center" Width="25"/>
                    <TextBox Name="TxtSend"
                             Width="470"
                             PlaceholderText="Text alebo HEX (napr. 01 03 00 00)"
                             FontFamily="Consolas"
                             FontSize="11"/>
                    <CheckBox Name="ChkSendHex" Content="HEX" Foreground="White" VerticalAlignment="Center"/>
                    <Button Content="Odoslať" Click="BtnSend_OnClick"
                            Padding="12,4" Background="#2E7D32" Foreground="White"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <Button Content="Zavrieť" Click="BtnClose_OnClick"
                Padding="20,8" Background="#B22222" Foreground="White"
                FontWeight="Bold" CornerRadius="4"
                HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
