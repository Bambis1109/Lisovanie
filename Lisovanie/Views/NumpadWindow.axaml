<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="using:Lisovanie.Views.UserControls"
        x:Class="Lisovanie.Views.NumpadWindow"
        Width="280" Height="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">

    <uc:UcNumpad x:Name="Pad" Confirmed="OnConfirmed" Cancelled="OnCancelled"/>
</Window>
