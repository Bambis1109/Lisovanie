<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MojaPrvaAvalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="120"
        x:Class="MojaPrvaAvalonia.Views.frmZoneSetup"
        x:DataType="vm:MainWindowViewModel"
        Title="Zóna Lisu – Nastavenie"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        CanResize="False"
        Background="#1E1E1E">

    <StackPanel Margin="10" Spacing="8">

        <Border Background="#2D2D30"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding ZonePress.Name}"
                           Foreground="White"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
             

                <TextBlock Text="Owner:"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding ZoneOwners}"
                          SelectedItem="{Binding ZonePress.Owner, Mode=TwoWay}"
                          Width="130"/>

                <TextBlock Text="Status:"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding ZoneStatuses}"
                          SelectedItem="{Binding ZonePress.Status, Mode=TwoWay}"
                          Width="150"/>
            </StackPanel>
        </Border>

        <Button Content="Zavrieť" Click="BtnClose_OnClick"
                Padding="20,8" Background="#B22222" Foreground="White"
                FontWeight="Bold" CornerRadius="4"
                HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
