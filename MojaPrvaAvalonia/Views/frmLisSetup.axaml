<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
        xmlns:models="using:MojaPrvaAvalonia.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="750"
        x:Class="MojaPrvaAvalonia.Views.frmLisSetup"
        x:DataType="models:CLis"
        Width="780" Height="900"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">

    <Grid RowDefinitions="*, Auto">
        <uc:UcLisSetup Name="UcSetup" Grid.Row="0" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15" Spacing="10">
            <Button Content="Settings" Click="BtnSettings_OnClick" 
                    Padding="20,10" Background="SteelBlue" Foreground="White" 
                    FontWeight="Bold" CornerRadius="5"/>
            <Button Content="Zavrieť" Click="BtnClose_OnClick" 
                    Padding="20,10" Background="#B22222" Foreground="White" 
                    FontWeight="Bold" CornerRadius="5"/>
        </StackPanel>
    </Grid>
</Window>