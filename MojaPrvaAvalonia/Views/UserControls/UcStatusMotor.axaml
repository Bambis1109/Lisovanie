<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MojaPrvaAvalonia.Models"
             mc:Ignorable="d" d:DesignWidth="150" d:DesignHeight="120"
             x:Class="MojaPrvaAvalonia.Views.UserControls.UcStatusMotor"
             x:DataType="models:CMotorData">

    <Border BorderBrush="#444444" 
            BorderThickness="2" 
            CornerRadius="6" 
            Padding="10" 
            Margin="5" 
            Background="#E8E8E8" 
            Width="140"
            TextElement.Foreground="Black">
            
        <StackPanel Spacing="3">
            <TextBlock Text="{Binding Name}" 
                       FontWeight="ExtraBold" 
                       FontSize="15" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,8" />
            
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="S:" FontWeight="Bold" Foreground="#004488" Margin="0,0,5,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Speed, StringFormat={}{0} rpm}" FontWeight="SemiBold"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="P:" FontWeight="Bold" Foreground="#004488" Margin="0,0,5,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Position, StringFormat={}{0}°}" FontWeight="SemiBold"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="I:" FontWeight="Bold" Foreground="#004488" Margin="0,0,5,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Current, StringFormat={}{0} A}" FontWeight="SemiBold"/>
                
            </Grid>
        </StackPanel>
    </Border>
</UserControl>