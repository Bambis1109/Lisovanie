<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MojaPrvaAvalonia.Models"
             xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="400"
             x:Class="MojaPrvaAvalonia.Views.UserControls.UcLis"
             x:DataType="models:CLis">

    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10" Background="#E0F0FF">
        <StackPanel Spacing="15">
            
            <!-- Base PLC Ovládanie -->
            <uc:UcStatusPlc />

            <Button Content="Setup" 
                    Click="BtnSetup_OnClick" 
                    HorizontalAlignment="Right"
                    Background="DodgerBlue"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="15,8"
                    CornerRadius="5"/>

            <Separator Height="1" Background="Gray" Margin="0,5"/>

            <!-- Reálne motory pre Lis (Zatiaľ len placeholder, keďže nemá reálne motory nakonfigurované) -->
            <ItemsControl ItemsSource="{Binding MotorViewModels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <uc:UcMotor />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </StackPanel>
    </Border>
</UserControl>