<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MojaPrvaAvalonia.Models"
             xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="250"
             x:Class="MojaPrvaAvalonia.Views.UserControls.UcStatusPlc"
             x:DataType="models:CManipulator">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="85"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10" Background="#DCDCDC">
        <StackPanel Spacing="15">
            
            <!-- Horný riadok: Farebné bloky (ZMENENÉ NA GRID) -->
            <Grid ColumnSpacing="10" ColumnDefinitions="Auto, Auto, Auto, Auto, *">
                
                <Border Grid.Column="0" Background="#424242" Width="100" Height="35" CornerRadius="5">
                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="1" Background="#5C2D91" Width="120" Height="35" CornerRadius="5">
                    <TextBlock Text="{Binding Connection}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="2" Background="#005A9E" Width="140" Height="35" CornerRadius="5">
                    <TextBlock Text="{Binding StatusPlc}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="3" Background="#D83B01" Width="50" Height="35" CornerRadius="5">
                    <TextBlock Text="{Binding Step}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Tento pm
                osledný stĺpec má Width="*" z definície, takže zaberie zvyšok dostupného miesta -->
                <Border Grid.Column="4" Background="#107C10" Height="35" CornerRadius="5">
                    <TextBlock Text="{Binding Message}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" Padding="15 0 0 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>
                
            </Grid>

            <!-- Tlačidlá -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                
                <!-- 1. Skupina: Pripojenie a Inicializácia -->
                <Button Content="Pripojiť" Command="{Binding ConnectCommand}" Background="LightBlue" />
                <Button Content="Init" Command="{Binding InitCommand}" Background="Plum" />

                <Border Width="2" Background="DarkGray" Margin="5,0"/>

                <!-- 2. Skupina: Hlavné ovládanie behu -->
                <Button Content="Štart" Command="{Binding StartProgramCommand}" Background="LightGreen" />
                <Button Content="Parkovať" Command="{Binding StopProgramOnEndCommand}" Background="Orange" />
                <Button Content="Stop" Command="{Binding StopProgramImmediatelyCommand}" Background="Salmon" />

                <Border Width="2" Background="DarkGray" Margin="5,0"/>

                <!-- 3. Skupina: Krokovanie -->
                <Button Content="{Binding ModeText}" 
                        Command="{Binding ToggleModeCommand}" 
                        Background="#E0E0E0" 
                        Width="110" />
                
                <Button Content="Krok" Command="{Binding NextStepProgramCommand}" Background="LightSkyBlue" />
                
            </StackPanel>

            <Separator Height="1" Background="Gray" Margin="0,5"/>

            <!-- Motory -->
            <ItemsControl ItemsSource="{Binding Motory}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <uc:UcStatusMotor />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </StackPanel>
    </Border>
</UserControl>