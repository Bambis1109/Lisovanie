<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MojaPrvaAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="100"
             x:Class="MojaPrvaAvalonia.Views.UserControls.UcDeviceScaleReduced"
             x:DataType="vm:UcDeviceScaleViewModel">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="5" Margin="2">
        <StackPanel Spacing="3">
            <TextBlock Text="{Binding ScaleName}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/>
            
            <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="W: " FontWeight="Bold" FontSize="11"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WeightFinalKg, StringFormat={}{0:F3} kg}" FontSize="11"/>
            </Grid>

            <Border Background="{Binding NmtColor}" CornerRadius="3" Margin="0,2,0,0" Padding="2">
                <TextBlock Text="{Binding NmtText}" Foreground="White" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>