<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MojaPrvaAvalonia.Models"
             xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
             xmlns:converters="using:MojaPrvaAvalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MojaPrvaAvalonia.Views.UserControls.UcControlLisSetup"
             x:DataType="models:CControlLis">

    <UserControl.Resources>
        <converters:BargraphColorConverter x:Key="BargraphColorConverter" />
        <converters:NegateConverter x:Key="NegateConverter" />
    </UserControl.Resources>

    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10">
        <StackPanel Spacing="15">
            <TextBlock Text="Lis Setup" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            
            <!-- Base PLC Ovládanie -->
            <uc:UcStatusPlc />

            <Separator Height="1" Background="Gray" Margin="0,5"/>

            <!-- Motory špecifické pre Lis -->
            <ItemsControl ItemsSource="{Binding MotorViewModels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <uc:UcDeviceEpos4 />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,10,0,0">
                <!-- Step Size Selection -->
                <TextBlock Text="Step size:" VerticalAlignment="Center" FontWeight="Bold"/>
                <RadioButton Content="0.1" GroupName="StepSize" IsChecked="{Binding StepSize, Converter={StaticResource EqualityConverter}, ConverterParameter=0.1}"/>
                <RadioButton Content="1" GroupName="StepSize" IsChecked="{Binding StepSize, Converter={StaticResource EqualityConverter}, ConverterParameter=1.0}"/>
                <RadioButton Content="10" GroupName="StepSize" IsChecked="{Binding StepSize, Converter={StaticResource EqualityConverter}, ConverterParameter=10.0}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                <!-- Stred Controls -->
                <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,10,0">
                    <TextBlock Text="Stred" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">
                        <ProgressBar Grid.Column="0" Orientation="Vertical" Margin="0,0,15,0" Width="20" VerticalAlignment="Center"
                                     Minimum="{Binding LimitStredDown, Converter={StaticResource NegateConverter}}" 
                                     Maximum="{Binding LimitStredUp, Converter={StaticResource NegateConverter}}"
                                     Value="{Binding MotorViewModels[0].DeviceEpos4Data.ActualGearPosition, Converter={StaticResource NegateConverter}}">
                            <ProgressBar.Foreground>
                                <MultiBinding Converter="{StaticResource BargraphColorConverter}">
                                    <Binding Path="MotorViewModels[0].DeviceEpos4Data.ActualGearPosition" />
                                    <Binding Path="LimitStredUp" />
                                    <Binding Path="LimitStredDown" />
                                </MultiBinding>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                        <Grid Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Button Grid.Row="0" Grid.Column="0" Content="Enable" Command="{Binding EnableStredCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="ForestGreen" Foreground="White" Margin="2"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Disable" Command="{Binding DisableStredCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="DarkRed" Foreground="White" Margin="2"/>
                            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Move Up" Command="{Binding MoveStredUpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="SteelBlue" Foreground="White" Margin="2"/>
                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Move Down" Command="{Binding MoveStredDownCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="SteelBlue" Foreground="White" Margin="2"/>
                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" Margin="2">
                                <Button Grid.Column="0" Content="-84" Command="{Binding MoveStredPos84Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                                <Button Grid.Column="1" Content="-60" Command="{Binding MoveStredPos60Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                                <Button Grid.Column="2" Content="-37" Command="{Binding MoveStredPos37Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                                <Button Grid.Column="3" Content="-14" Command="{Binding MoveStredPos14Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- Lis Controls -->
                <StackPanel Grid.Column="1" Spacing="10" Margin="10,0,0,0">
                    <TextBlock Text="Lis" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">
                        <ProgressBar Grid.Column="0" Orientation="Vertical" Margin="0,0,15,0" Width="20" VerticalAlignment="Center"
                                     Minimum="{Binding LimitLisDown}" Maximum="{Binding LimitLisUp}"
                                     Value="{Binding MotorViewModels[2].DeviceEpos4Data.ActualGearPosition}">
                            <ProgressBar.Foreground>
                                <MultiBinding Converter="{StaticResource BargraphColorConverter}">
                                    <Binding Path="MotorViewModels[2].DeviceEpos4Data.ActualGearPosition" />
                                    <Binding Path="LimitLisDown" />
                                    <Binding Path="LimitLisUp" />
                                </MultiBinding>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                        <Grid Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Button Grid.Row="0" Grid.Column="0" Content="Enable" Command="{Binding EnableLisCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="ForestGreen" Foreground="White" Margin="2"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="Disable" Command="{Binding DisableLisCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="DarkRed" Foreground="White" Margin="2"/>
                            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Move Up" Command="{Binding MoveLisUpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Chocolate" Foreground="White" Margin="2"/>
                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Move Down" Command="{Binding MoveLisDownCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Chocolate" Foreground="White" Margin="2"/>
                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" Margin="2">
                                <Button Grid.Column="0" Content="0" Command="{Binding MoveMasterPos0Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                                <Button Grid.Column="1" Content="-100" Command="{Binding MoveMasterPosMinus100Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                                <Button Grid.Column="2" Content="-160" Command="{Binding MoveMasterPosMinus160Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                                <Button Grid.Column="3" Content="-220" Command="{Binding MoveMasterPosMinus220Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="2" Margin="1"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>

            <Separator Height="1" Background="Gray" Margin="0,10"/>
            
        </StackPanel>
    </Border>
</UserControl>