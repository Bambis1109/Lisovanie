<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MojaPrvaAvalonia.Models"
             xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="400"
             x:Class="MojaPrvaAvalonia.Views.UserControls.UcManipulatorSetup"
             x:DataType="models:CManipulator">

    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10" Background="#E0E0E0">
        <StackPanel Spacing="15">
            <TextBlock Text="Manipulator Setup" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            
            <!-- Base PLC Ovládanie -->
            <uc:UcStatusPlc />

            <Separator Height="1" Background="Gray" Margin="0,5"/>

            <!-- Reálne motory pre Manipulátor -->
            <ItemsControl ItemsSource="{Binding MotorViewModels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <uc:UcMotor />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,10,0,0">
                <!-- Mode Selection -->
                <TextBlock Text="Mode:" VerticalAlignment="Center" FontWeight="Bold"/>
                <RadioButton Content="Polar" GroupName="MoveMode" IsChecked="{Binding deltaRobot.MovementMode, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:EnMovementMode.Polar}}"/>
                <RadioButton Content="XY" GroupName="MoveMode" IsChecked="{Binding deltaRobot.MovementMode, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:EnMovementMode.XY}}"/>
                
                <Separator Width="1" Background="Gray" Margin="10,0"/>

                <!-- Step Size Selection -->
                <TextBlock Text="Step size:" VerticalAlignment="Center" FontWeight="Bold"/>
                <RadioButton Content="0.1" GroupName="StepSize" IsChecked="{Binding deltaRobot.StepSize, Converter={StaticResource EqualityConverter}, ConverterParameter=0.1}"/>
                <RadioButton Content="1" GroupName="StepSize" IsChecked="{Binding deltaRobot.StepSize, Converter={StaticResource EqualityConverter}, ConverterParameter=1.0}"/>
                <RadioButton Content="10" GroupName="StepSize" IsChecked="{Binding deltaRobot.StepSize, Converter={StaticResource EqualityConverter}, ConverterParameter=10.0}"/>
            </StackPanel>

            <Grid ColumnDefinitions="2*,*,*" Margin="0,10,0,0">
                <!-- Delta Arm Controls -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" Margin="0,0,10,0">
                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Angle" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding deltaRobot.CurrentPhi, StringFormat=\{0:F1\}°}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Grid.Row="0" Grid.Column="1" Content="{Binding deltaRobot.MovementMode, Converter={StaticResource UpButtonLabelConverter}}" Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="SteelBlue" Foreground="White"/>
                    
                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Distance" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding deltaRobot.CurrentR, StringFormat=\{0:F1\}mm}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Row="1" Grid.Column="0" Content="{Binding deltaRobot.MovementMode, Converter={StaticResource LeftButtonLabelConverter}}" Command="{Binding MoveLeftCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="SteelBlue" Foreground="White"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="{Binding deltaRobot.MovementMode, Converter={StaticResource RightButtonLabelConverter}}" Command="{Binding MoveRightCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="SteelBlue" Foreground="White"/>
                    
                    <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="X" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding deltaRobot.CurrentX, StringFormat=\{0:F1\}mm}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Row="2" Grid.Column="1" Content="{Binding deltaRobot.MovementMode, Converter={StaticResource DownButtonLabelConverter}}" Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="SteelBlue" Foreground="White"/>

                    <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Y" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding deltaRobot.CurrentY, StringFormat=\{0:F1\}mm}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Jaws Controls -->
                <StackPanel Grid.Column="1" Spacing="10" Margin="5,0,5,0">
                    <TextBlock Text="Jaws" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <Button Content="Open" Command="{Binding JawsOpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="DarkSeaGreen" Foreground="White"/>
                    <Button Content="Close" Command="{Binding JawsCloseCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="DarkSeaGreen" Foreground="White"/>
                </StackPanel>

                <!-- Z-Axis Controls -->
                <StackPanel Grid.Column="2" Spacing="10" Margin="5,0,0,0">
                    <TextBlock Text="Z-Axis" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <Button Content="Z UP" Command="{Binding MoveZUpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Chocolate" Foreground="White"/>
                    <Button Content="Z Down" Command="{Binding MoveZDownCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Chocolate" Foreground="White"/>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                <!-- Lavý stĺpec: Parametre -->
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,5,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Parameters" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,2*">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="OffsetArm:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Parameters.OffsetArm}" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="OffsetSystem:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Parameters.OffsetSystem}" Margin="0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Pravý stĺpec: Akcie -->
                <StackPanel Grid.Column="1" Spacing="10" Margin="5,0,0,0">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Hardware Actions" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Content="Enable" Command="{Binding EnableMotorsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="ForestGreen" Foreground="White" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Content="Disable" Command="{Binding DisableMotorsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="DarkRed" Foreground="White" Margin="5,0,0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Content="Kalibruj" Command="{Binding KalibrujCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Content="Orientuj" Command="{Binding OrientujCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Content="Save Params" Command="{Binding SaveParametersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Content="Load Params" Command="{Binding LoadParametersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            
        </StackPanel>
    </Border>
</UserControl>