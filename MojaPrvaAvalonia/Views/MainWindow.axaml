
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MojaPrvaAvalonia.ViewModels"
        xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
        xmlns:models="using:MojaPrvaAvalonia.Models"
        xmlns:sys="using:System"
        xmlns:conv="using:MojaPrvaAvalonia.Converters"
        x:Class="MojaPrvaAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="760" Height="900"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">
    
    <Window.Resources>
        <conv:LogColorConverter x:Key="LogColorConv"/>
        <conv:ProduktStatusColorConverter x:Key="ProduktStatusColorConv"/>
    </Window.Resources>
    
    <Grid RowDefinitions="*, Auto, 200">

        <!-- Horná časť: PLC panely -->
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="10">
                <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0"
                               Text="LISOVANIE"
                               FontSize="20"
                               FontWeight="ExtraBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding MainProgram.IxxatState}"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,15,0"
                               Foreground="Yellow"/>

                    <Button Grid.Column="2"
                            Content="Setup"
                            Click="BtnZoneSetup_OnClick"
                            Background="#6A1B9A"
                            Foreground="White"
                            Width="100"
                            Padding="0,5"
                            HorizontalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="5"
                            Margin="0,0,5,0"/>

                    <Button Grid.Column="3"
                            Content="Connect"
                            Command="{Binding ConnectCommand}"
                            Background="ForestGreen"
                            Foreground="White"
                            Width="100"
                            Padding="0,5"
                            HorizontalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="5"
                            Margin="0,0,5,0"/>

                    <Button Grid.Column="4"
                            Content="Exit"
                            Command="{Binding ExitApplicationCommand}"
                            Background="#B22222"
                            Foreground="White"
                            Width="100"
                            Padding="0,5"
                            HorizontalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="5"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding MainProgram.ZoznamPlc}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="models:CControlManipulator">
                            <uc:UcControlManipulator />
                        </DataTemplate>
                        <DataTemplate DataType="models:CControlLis">
                            <uc:UcControlLis />
                        </DataTemplate>
                        <DataTemplate DataType="models:CControlScales">
                            <uc:UcControlScales />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Stredná časť: Výrobné dáta dávky -->
        <Border Grid.Row="1"
                Background="#252526" BorderBrush="#444" BorderThickness="0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="Auto, 1, *">

                <!-- OK / NOK počítadlá (Manipulátor) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="OK" FontWeight="Bold" FontSize="22" Foreground="LimeGreen" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Manipulator.MatrixOK.ActualItem}" FontWeight="Bold" FontSize="22" Foreground="LimeGreen" VerticalAlignment="Center"/>
                        <TextBlock Text="zo" FontSize="14" Foreground="LimeGreen" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Manipulator.MatrixOK.CountItem}" FontSize="14" Foreground="LimeGreen" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="NOK" FontWeight="Bold" FontSize="22" Foreground="Red" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Manipulator.MatrixNOK.ActualItem}" FontWeight="Bold" FontSize="22" Foreground="Red" VerticalAlignment="Center"/>
                        <TextBlock Text="zo" FontSize="14" Foreground="Red" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Manipulator.MatrixNOK.CountItem}" FontSize="14" Foreground="Red" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Zvislý oddeľovač -->
                <Border Grid.Column="1" Background="#555" Margin="12,2"/>

                <!-- Aktuálny + Posledný produkt (Lis) -->
                <Grid Grid.Column="2" ColumnDefinitions="*, 1, *">

                    <!-- Aktuálny produkt -->
                    <StackPanel Grid.Column="0" Spacing="2" Margin="8,0">
                        <TextBlock Text="Aktuálny produkt" FontSize="11" Foreground="Gray" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Sila:" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Lis.ProduktLisActual.Sila, StringFormat={}{0:F0} N}"
                                           Foreground="Yellow" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Výška:" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Lis.ProduktLisActual.Vyska, StringFormat={}{0:F2} mm}"
                                           Foreground="Cyan" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Lis.ProduktLisActual.Status}"
                                       Foreground="{Binding Lis.ProduktLisActual.Status, Converter={StaticResource ProduktStatusColorConv}}"
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Zvislý oddeľovač -->
                    <Border Grid.Column="1" Background="#555" Margin="0,2"/>

                    <!-- Posledný produkt -->
                    <StackPanel Grid.Column="2" Spacing="2" Margin="8,0">
                        <TextBlock Text="Posledný produkt" FontSize="11" Foreground="Gray" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Sila:" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Lis.ProduktLisLast.Sila, StringFormat={}{0:F0} N}"
                                           Foreground="Yellow" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Výška:" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Lis.ProduktLisLast.Vyska, StringFormat={}{0:F2} mm}"
                                           Foreground="Cyan" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Lis.ProduktLisLast.Status}"
                                       Foreground="{Binding Lis.ProduktLisLast.Status, Converter={StaticResource ProduktStatusColorConv}}"
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>

        <!-- Dolná časť: Logy -->
        <ListBox x:Name="LogListBox"
                 Grid.Row="2"
                 ItemsSource="{Binding VypisLogov}" 
                 Background="#1E1E1E" 
                 FontFamily="Consolas"
                 Margin="5"
                 CornerRadius="5">

            <ListBox.Styles>
                <Style Selector="ListBox">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                </Style>
        
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="5,0"/> 
                    <Setter Property="MinHeight" Value="0"/> 
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}" 
                               Foreground="{Binding Converter={StaticResource LogColorConv}}" 
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>