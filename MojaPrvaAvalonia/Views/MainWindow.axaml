
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MojaPrvaAvalonia.ViewModels"
        xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
        xmlns:models="using:MojaPrvaAvalonia.Models"
        xmlns:sys="using:System"
        xmlns:conv="using:MojaPrvaAvalonia.Converters"
        x:Class="MojaPrvaAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Multi-PLC Ovládanie"
        Width="1400" Height="800"> <!-- Zväčšil som predvolené okno -->
    
    <Window.Resources>
        <conv:LogColorConverter x:Key="LogColorConv"/>
    </Window.Resources>
    
    <!-- ZMENA: Ľavý stĺpec sa prispôsobí obsahu (Auto), pravý zaberie zvyšok (*) -->
    <Grid ColumnDefinitions="Auto, *">

        <!-- ZMENA: Pridaná MinWidth="750", aby sa PLC panel nikdy nezmenšil pod túto hodnotu -->
        <ScrollViewer Grid.Column="0" MinWidth="750" Margin="0,0,10,0">
            <StackPanel Margin="20">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                    <TextBlock Grid.Column="0" 
                               Text="Systém Riadenia Liniek" 
                               FontSize="24" 
                               FontWeight="ExtraBold" 
                               HorizontalAlignment="Center" />
                    
                    <Button Grid.Column="1" 
                            Content="Exit" 
                            Command="{Binding ExitApplicationCommand}"
                            Background="#B22222"
                            Foreground="White"
                            Padding="20,10"
                            FontWeight="Bold"
                            CornerRadius="5"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding MainProgram.ZoznamPlc}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="models:CManipulator">
                            <uc:UcManipulator />
                        </DataTemplate>
                        <DataTemplate DataType="models:CLis">
                            <uc:UcLis />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ListBox x:Name="LogListBox"
                 Grid.Column="1"
                 ItemsSource="{Binding VypisLogov}" 
                 Background="#1E1E1E" 
                 FontFamily="Consolas"
                 Margin="10"
                 CornerRadius="5">

            <ListBox.Styles>
                <Style Selector="ListBox">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                </Style>
        
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="5,0"/> 
                    <Setter Property="MinHeight" Value="0"/> 
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}" 
                               Foreground="{Binding Converter={StaticResource LogColorConv}}" 
                               TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>