
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MojaPrvaAvalonia.ViewModels"
        xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
        xmlns:models="using:MojaPrvaAvalonia.Models"
        xmlns:sys="using:System"
        xmlns:conv="using:MojaPrvaAvalonia.Converters"
        x:Class="MojaPrvaAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="760" Height="900"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">
    
    <Window.Resources>
        <conv:LogColorConverter x:Key="LogColorConv"/>
    </Window.Resources>
    
    <Grid RowDefinitions="*, 250">

        <!-- Horná časť: PLC panely -->
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="10">
                <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0"
                               Text="LISOVANIE"
                               FontSize="20"
                               FontWeight="ExtraBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding MainProgram.IxxatState}"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,0,15,0"
                               Foreground="Yellow"/>

                    <Button Grid.Column="2"
                            Content="Setup"
                            Click="BtnZoneSetup_OnClick"
                            Background="#6A1B9A"
                            Foreground="White"
                            Width="100"
                            Padding="0,5"
                            HorizontalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="5"
                            Margin="0,0,5,0"/>

                    <Button Grid.Column="3"
                            Content="Connect"
                            Command="{Binding ConnectCommand}"
                            Background="ForestGreen"
                            Foreground="White"
                            Width="100"
                            Padding="0,5"
                            HorizontalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="5"
                            Margin="0,0,5,0"/>

                    <Button Grid.Column="4"
                            Content="Exit"
                            Command="{Binding ExitApplicationCommand}"
                            Background="#B22222"
                            Foreground="White"
                            Width="100"
                            Padding="0,5"
                            HorizontalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="5"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding MainProgram.ZoznamPlc}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="models:CControlManipulator">
                            <uc:UcControlManipulator />
                        </DataTemplate>
                        <DataTemplate DataType="models:CControlLis">
                            <uc:UcControlLis />
                        </DataTemplate>
                        <DataTemplate DataType="models:CControlScales">
                            <uc:UcControlScales />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Dolná časť: Logy -->
        <ListBox x:Name="LogListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding VypisLogov}" 
                 Background="#1E1E1E" 
                 FontFamily="Consolas"
                 Margin="5"
                 CornerRadius="5">

            <ListBox.Styles>
                <Style Selector="ListBox">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                </Style>
        
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="5,0"/> 
                    <Setter Property="MinHeight" Value="0"/> 
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}" 
                               Foreground="{Binding Converter={StaticResource LogColorConv}}" 
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>