<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="using:MojaPrvaAvalonia.Views.UserControls"
        xmlns:models="using:MojaPrvaAvalonia.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MojaPrvaAvalonia.Views.frmManipulatorSetup"
        x:DataType="models:CManipulator"
        Title="Manipulator Setup"
        Width="780" Height="500"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
    
    <Grid RowDefinitions="*, Auto">
        <uc:UcManipulatorSetup Name="UcSetup" Grid.Row="0" />
        <Button Grid.Row="1" Content="Exit" Click="BtnExit_OnClick" 
                HorizontalAlignment="Right" Margin="15" Padding="20,10" 
                Background="#B22222" Foreground="White" FontWeight="Bold" CornerRadius="5"/>
    </Grid>
</Window>