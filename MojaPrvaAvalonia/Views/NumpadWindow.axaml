<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MojaPrvaAvalonia.Views.NumpadWindow"
        Width="280" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="False" WindowDecorations="Full" Background="#1E1E1E">
    
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Background" Value="#444444"/>
        </Style>
        <Style Selector="Button.ok">
            <Setter Property="Background" Value="ForestGreen"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="DarkRed"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" Background="#2D2D30" ColumnDefinitions="*, Auto">
            <TextBlock x:Name="TitleBlock" Text="Zadajte hodnotu" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Grid.Column="1" Content="X" Click="BtnCancel_OnClick" Classes="cancel" Width="40" Height="40" Margin="5" FontSize="14"/>
        </Grid>
        
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="10" Padding="5">
            <TextBlock x:Name="DisplayBlock" Text="0" FontSize="30" TextAlignment="Right"/>
        </Border>

        <Grid Grid.Row="2" Margin="10" 
              RowDefinitions="*,*,*,*" 
              ColumnDefinitions="*,*,*,*">
            
            <Button Grid.Row="0" Grid.Column="0" Content="7" Click="BtnNum_OnClick"/>
            <Button Grid.Row="0" Grid.Column="1" Content="8" Click="BtnNum_OnClick"/>
            <Button Grid.Row="0" Grid.Column="2" Content="9" Click="BtnNum_OnClick"/>
            <Button Grid.Row="0" Grid.Column="3" Content="C" Click="BtnClear_OnClick" Classes="action"/>
            
            <Button Grid.Row="1" Grid.Column="0" Content="4" Click="BtnNum_OnClick"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" Click="BtnNum_OnClick"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" Click="BtnNum_OnClick"/>
            <Button Grid.Row="1" Grid.Column="3" Content="←" Click="BtnDel_OnClick" Classes="action"/>
            
            <Button Grid.Row="2" Grid.Column="0" Content="1" Click="BtnNum_OnClick"/>
            <Button Grid.Row="2" Grid.Column="1" Content="2" Click="BtnNum_OnClick"/>
            <Button Grid.Row="2" Grid.Column="2" Content="3" Click="BtnNum_OnClick"/>
            <Button Grid.Row="2" Grid.RowSpan="2" Grid.Column="3" Content="OK" Click="BtnOk_OnClick" Classes="ok" Height="124"/>
            
            <Button Grid.Row="3" Grid.Column="0" Content="+/-" Click="BtnSign_OnClick" Classes="action"/>
            <Button Grid.Row="3" Grid.Column="1" Content="0" Click="BtnNum_OnClick"/>
            <Button Grid.Row="3" Grid.Column="2" Content="." Click="BtnNum_OnClick"/>
        </Grid>
    </Grid>
</Window>
